# Fantareal Android release 签名配置模板。
# 复制本文件为 signing/keystore.properties 并填入真实值。
# signing/keystore.properties 已被 .gitignore 忽略，严禁提交。
#
# 生成新密钥库：
#   keytool -genkeypair -v -keystore signing/fantareal.jks \
#     -alias fantareal -keyalg RSA -keysize 2048 -validity 10000
#
# 路径相对于项目根目录解析（rootProject.file(...)）。

storeFile=signing/fantareal.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=fantareal
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
